# ── Supabase ──────────────────────────────────────────────────────────────────
# Pooled connection (port 6543) — used by Prisma at runtime
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — used by Prisma for migrations
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # never expose to frontend

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=https://[ENDPOINT].upstash.io
UPSTASH_REDIS_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Public URL of this backend and of the frontend — used to build OAuth
# redirect URIs and post-connect redirects.
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Workspace integration security ─────────────────────────────────────────────
# ENCRYPTION_KEY: 64-char hex string (32 bytes) — encrypts Drive/Notion OAuth
# tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# OAUTH_STATE_SECRET: any long random string — signs the OAuth `state` param.
OAUTH_STATE_SECRET=
# INTERNAL_API_KEY: shared secret for agent-service's internal token calls.
# Must match agent-service's INTERNAL_API_KEY.
INTERNAL_API_KEY=

# ── Google Drive OAuth (Brand Voice Vault ingestion) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Notion OAuth (Brand Voice Vault ingestion) ─────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
