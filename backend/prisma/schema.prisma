generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Enums ----

enum OrgType {
  agency
  brand

  @@map("org_type")
}

enum UserRole {
  org_admin
  workspace_member
  super_admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  invited

  @@map("user_status")
}

enum AgentMode {
  approval_gated
  autonomous

  @@map("agent_mode")
}

enum UiTheme {
  dark
  light

  @@map("ui_theme")
}

enum AgentRunStatus {
  queued
  running
  complete
  failed

  @@map("agent_run_status")
}

enum AgentType {
  research
  architect
  icp
  market_sizing
  builder
  analyst
  vault_ingest

  @@map("agent_type")
}

enum VaultDocStatus {
  queued
  processing
  ready
  failed

  @@map("vault_doc_status")
}

enum VaultSourceType {
  pdf
  url
  free_text
  google_drive
  notion

  @@map("vault_source_type")
}

enum CampaignGoal {
  awareness
  leads
  pipeline
  retention

  @@map("campaign_goal")
}

enum CampaignChannel {
  linkedin
  google_search
  google_display
  meta
  email

  @@map("campaign_channel")
}

enum PlaybookStatus {
  draft
  approved
  archived

  @@map("playbook_status")
}

enum CreditActionType {
  research_run
  architect_run
  icp_run
  market_sizing_run
  vault_ingest

  @@map("credit_action_type")
}

enum ProjectStatus {
  active
  archived

  @@map("project_status")
}

enum CampaignStatus {
  active
  completed
  archived

  @@map("campaign_status")
}

enum IntegrationProvider {
  google_drive
  notion

  @@map("integration_provider")
}

enum IntegrationStatus {
  connected
  disconnected
  error

  @@map("integration_status")
}

// ---- Models ----

model Organisation {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String
  orgType            OrgType   @default(brand) @map("org_type")
  creditBalance      Int       @default(100) @map("credit_balance")
  creditCap          Int       @default(1000) @map("credit_cap")
  stripeCustomerId   String?   @map("stripe_customer_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspaces         Workspace[]
  profiles           Profile[]
  creditLedger       CreditLedger[]

  @@map("organisations")
}

model Workspace {
  id             String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String     @map("org_id") @db.Uuid
  name           String
  description    String?
  agentMode      AgentMode  @default(approval_gated) @map("agent_mode")
  creditSoftCap  Int?       @map("credit_soft_cap")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation   Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  vaultDocuments VaultDocument[]
  agentRuns      AgentRun[]
  playbooks      CampaignPlaybook[]
  creditLedger   CreditLedger[]
  projects       Project[]
  campaigns           Campaign[]
  researchSignals     ResearchSignal[]
  icpProfiles         IcpProfile[]
  marketSizingReports MarketSizingReport[]
  integrations        WorkspaceIntegration[]

  @@map("workspaces")
}

model Profile {
  id         String      @id @db.Uuid
  email      String
  fullName   String?     @map("full_name")
  avatarUrl  String?     @map("avatar_url")
  role       UserRole    @default(workspace_member)
  status     UserStatus  @default(active)
  orgId      String?     @map("org_id") @db.Uuid
  uiTheme    UiTheme     @default(dark) @map("ui_theme")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation       Organisation?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  workspaceMembers   WorkspaceMember[]
  vaultDocuments     VaultDocument[]
  agentRuns          AgentRun[]
  approvedPlaybooks  CampaignPlaybook[] @relation("ApprovedBy")
  creditLedger       CreditLedger[]
  createdProjects    Project[]
  createdCampaigns   Campaign[]
  connectedIntegrations WorkspaceIntegration[]

  @@map("profiles")
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  role        UserRole  @default(workspace_member)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@map("workspace_members")
}

model VaultDocument {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  name            String
  sourceType      VaultSourceType @map("source_type")
  filePath        String?         @map("file_path")
  fileSizeBytes   Int?            @map("file_size_bytes")
  integrationId   String?         @map("integration_id") @db.Uuid
  externalFileId  String?         @map("external_file_id")
  externalFileUrl String?         @map("external_file_url")
  status          VaultDocStatus  @default(queued)
  errorMessage    String?         @map("error_message")
  chunkCount      Int?            @map("chunk_count")
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     Profile               @relation(fields: [createdBy], references: [id])
  integration WorkspaceIntegration? @relation(fields: [integrationId], references: [id])

  @@map("vault_documents")
}

model Project {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(active)
  createdBy   String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             Profile              @relation(fields: [createdBy], references: [id])
  campaigns           Campaign[]
  researchSignals     ResearchSignal[]
  icpProfiles         IcpProfile[]
  marketSizingReports MarketSizingReport[]
  agentRuns           AgentRun[]
  playbooks           CampaignPlaybook[]

  @@map("projects")
}

model Campaign {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId  String            @map("workspace_id") @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  name         String
  campaignGoal CampaignGoal      @map("campaign_goal")
  channels     CampaignChannel[]
  status       CampaignStatus    @default(active)
  createdBy    String            @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   Profile            @relation(fields: [createdBy], references: [id])
  playbooks CampaignPlaybook[]
  agentRuns AgentRun[]

  @@map("campaigns")
}

model AgentRun {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  projectId     String?        @map("project_id") @db.Uuid
  campaignId    String?        @map("campaign_id") @db.Uuid
  agentType     AgentType      @map("agent_type")
  status        AgentRunStatus @default(queued)
  jobId         String?        @map("job_id")
  inputPayload  Json           @default("{}") @map("input_payload")
  errorMessage  String?        @map("error_message")
  creditsUsed   Int            @default(0) @map("credits_used")
  startedAt     DateTime?      @map("started_at") @db.Timestamptz
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz
  triggeredBy   String         @map("triggered_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  triggeredByProfile Profile             @relation(fields: [triggeredBy], references: [id])
  researchSignal      ResearchSignal?
  icpProfile          IcpProfile?
  marketSizingReport  MarketSizingReport?
  playbook      CampaignPlaybook?
  creditLedger  CreditLedger[]

  @@map("agent_runs")
}

model ResearchSignal {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  agentRunId          String   @unique @map("agent_run_id") @db.Uuid
  competitorsAnalysed String[] @map("competitors_analysed")
  competitorProfiles  Json     @default("[]") @map("competitor_profiles")
  marketGaps          String[] @map("market_gaps")
  intentTriggers      String[] @map("intent_triggers")
  recommendedAngles   String[] @map("recommended_angles")
  sources             String[]
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun            AgentRun             @relation(fields: [agentRunId], references: [id])
  playbooks           CampaignPlaybook[]
  icpProfiles         IcpProfile[]
  marketSizingReports MarketSizingReport[]

  @@map("research_signals")
}

model IcpProfile {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  agentRunId       String   @unique @map("agent_run_id") @db.Uuid
  researchSignalId String?  @map("research_signal_id") @db.Uuid
  firmographics    Json     @default("{}") @map("firmographics")
  personas         Json     @default("[]") @map("personas")
  painPoints       String[] @map("pain_points")
  buyingTriggers   String[] @map("buying_triggers")
  sources          String[]
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun       AgentRun           @relation(fields: [agentRunId], references: [id])
  researchSignal ResearchSignal?    @relation(fields: [researchSignalId], references: [id])
  playbooks      CampaignPlaybook[]

  @@map("icp_profiles")
}

model MarketSizingReport {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  agentRunId       String   @unique @map("agent_run_id") @db.Uuid
  researchSignalId String?  @map("research_signal_id") @db.Uuid
  tamEstimate      Json     @map("tam_estimate")
  samEstimate      Json     @map("sam_estimate")
  somEstimate      Json     @map("som_estimate")
  methodologyNotes String   @map("methodology_notes")
  sources          String[]
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun       AgentRun           @relation(fields: [agentRunId], references: [id])
  researchSignal ResearchSignal?    @relation(fields: [researchSignalId], references: [id])
  playbooks      CampaignPlaybook[]

  @@map("market_sizing_reports")
}

model WorkspaceIntegration {
  id                    String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId           String              @map("workspace_id") @db.Uuid
  provider              IntegrationProvider
  status                IntegrationStatus   @default(connected)
  accessTokenEncrypted  String              @map("access_token_encrypted")
  refreshTokenEncrypted String?             @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?           @map("token_expires_at") @db.Timestamptz
  externalAccountId     String?             @map("external_account_id")
  externalAccountLabel  String?             @map("external_account_label")
  scopes                String[]
  connectedBy           String              @map("connected_by") @db.Uuid
  connectedAt           DateTime            @default(now()) @map("connected_at") @db.Timestamptz
  lastSyncedAt          DateTime?           @map("last_synced_at") @db.Timestamptz
  errorMessage          String?             @map("error_message")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector Profile         @relation(fields: [connectedBy], references: [id])
  vaultDocs VaultDocument[]

  @@unique([workspaceId, provider])
  @@map("workspace_integrations")
}

model CampaignPlaybook {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId          String            @map("workspace_id") @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  campaignId           String            @map("campaign_id") @db.Uuid
  agentRunId           String            @unique @map("agent_run_id") @db.Uuid
  researchSignalId     String?           @map("research_signal_id") @db.Uuid
  icpProfileId         String?           @map("icp_profile_id") @db.Uuid
  marketSizingReportId String?           @map("market_sizing_report_id") @db.Uuid
  campaignGoal         CampaignGoal      @map("campaign_goal")
  channels             CampaignChannel[]
  winningAngle         String            @map("winning_angle")
  targetPersona        String            @map("target_persona")
  playbookContent      Json              @default("{}") @map("playbook_content")
  status               PlaybookStatus    @default(draft)
  approvedBy           String?           @map("approved_by") @db.Uuid
  approvedAt           DateTime?         @map("approved_at") @db.Timestamptz
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign            Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agentRun           AgentRun            @relation(fields: [agentRunId], references: [id])
  researchSignal     ResearchSignal?     @relation(fields: [researchSignalId], references: [id])
  icpProfile         IcpProfile?         @relation(fields: [icpProfileId], references: [id])
  marketSizingReport MarketSizingReport? @relation(fields: [marketSizingReportId], references: [id])
  approver           Profile?            @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@map("campaign_playbooks")
}

model CreditLedger {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  agentRunId  String?          @map("agent_run_id") @db.Uuid
  actionType  CreditActionType @map("action_type")
  creditsUsed Int              @map("credits_used")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id])
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@map("credit_ledger")
}
