# ── Supabase (service role only — never expose to frontend) ───────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (embeddings only — text-embedding-3-small) ────────────────────────
OPENAI_API_KEY=sk-...

# ── Firecrawl ─────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=https://[ENDPOINT].upstash.io
UPSTASH_REDIS_TOKEN=

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Backend-internal (Google Drive / Notion vault ingestion) ──────────────────
# Agent-service never holds OAuth client secrets — it fetches a live,
# refreshed token from the backend's internal endpoint, authenticated with
# this shared key. Must match the backend's INTERNAL_API_KEY.
BACKEND_INTERNAL_URL=http://localhost:3001
INTERNAL_API_KEY=
